# Second brand (docker-compose.brand2.yml). Copy to .env.brand2 and fill in.
# Read by compose (--env-file) and by the brand2 backend container. Everything else
# (AI key, Instagram, Telegram, knowledge base) is set in this brand's own panel.

# --- Brand ---
# Shown in the panel, the AI's replies and the legal pages
BRAND_NAME=Yangi Markaz
# Panel title; empty -> "<BRAND_NAME> AI Agent"
BRAND_APP_NAME=
# Funnel keywords, comma separated; empty -> BRAND_NAME
BRAND_KEYWORDS=

# --- Database (this brand's own postgres container) ---
POSTGRES_PASSWORD=change-me-strong

# --- Security --- must NOT be the main instance's values
# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Do NOT change SECRET_KEY later: secrets stored in the DB become unreadable.
SECRET_KEY=change-me
# First admin (created only when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Public address --- https:// + the BRAND2_DOMAIN set in the main .env
# Needed for Instagram/Telegram webhooks; empty -> Telegram long polling (local test)
PUBLIC_URL=

TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
