# Copy to .env and fill in. Only infrastructure lives here — AI keys, Instagram,
# Telegram and the knowledge base are set in the admin panel (Sozlamalar).

# --- Database ---
POSTGRES_USER=wk
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=wk_agent

# --- Security ---
# Long random string (JWT + encryption of secrets in the DB). Do NOT change later:
# stored secrets become unreadable.  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# First admin (created only when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Public address (HTTPS) — needed for Instagram/Telegram webhooks ---
# e.g. https://agent.wunderkind.uz   (locally: an ngrok https URL)
PUBLIC_URL=

# --- Production web server ---
# Domain for automatic HTTPS; keep ":80" for local http://localhost:8080
SITE_ADDRESS=:80
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443

TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
