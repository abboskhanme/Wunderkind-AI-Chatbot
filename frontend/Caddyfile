# SITE_ADDRESS: ":80" locally; a domain in production (Caddy then gets HTTPS itself)
{$SITE_ADDRESS::80} {
	encode gzip

	# /privacy /terms /data-deletion: public legal pages rendered by the backend (Meta App Review)
	@backend path /api/* /webhook/* /connect/* /health /privacy /terms /data-deletion
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
