# SITE_ADDRESS: ":80" locally; a domain in production (Caddy then gets HTTPS itself)
{$SITE_ADDRESS::80} {
	encode gzip

	# /privacy /terms /data-deletion: public legal pages rendered by the backend (Meta App Review)
	# /go/*: landing page behind the Instagram «Qo'llanmani olish» button (opens Telegram)
	# /f/*: public forms («Formalar», SPEC §15)
	# Public form answers are small; stop huge bodies before they reach the backend
	@forms path /f/*
	request_body @forms {
		max_size 256KB
	}

	@backend path /api/* /webhook/* /connect/* /health /privacy /terms /data-deletion /go/* /f/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
